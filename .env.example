# ---------- سینا OS — نمونهٔ تنظیمات ----------
# این فایل را به backend/.env کپی کنید یا فقط `python sina.py` را اجرا کنید (خودش می‌سازد).
ENV=local
DEBUG=false
AUTO_CREATE_TABLES=true
SERVE_CONSOLE=true

# دیتابیس: پیش‌فرض SQLite (بدون نصب چیزی). برای Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sina
DATABASE_URL=sqlite+aiosqlite:///./data/sina.db
WORKSPACE_ROOT=./data/sina-ai

# امنیت — مقدار تصادفی بگذارید: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-48-random-bytes
ADMIN_EMAIL=admin@sina.local
ADMIN_PASSWORD=change-me-too
ADMIN_NAME=مدیر

# ---------- مدل زبانی ----------
# یا کلید OpenRouter (صدها مدل با یک کلید) یا کلید OpenAI/Groq/… از صفحهٔ اتصال‌ها
OPENROUTER_API_KEY=
DEFAULT_MODEL=deepseek/deepseek-chat-v3.1:free
CODING_MODEL=qwen/qwen3-coder:free
REASONING_MODEL=deepseek/deepseek-r1-0528:free
MODEL_FALLBACKS=meta-llama/llama-3.3-70b-instruct:free
LLM_MAX_TOKENS=4096

# ---------- اجرا ----------
EXEC_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=25
REQUIRE_APPROVAL_LEVELS=confirm,admin
PIP_ALLOWLIST=requests,httpx,fastapi,flask,uvicorn,pytest,numpy,pandas,beautifulsoup4,pydantic,sqlalchemy,rich,click,pyyaml,python-dateutil

# ---------- اختیاری: نسخهٔ چند‌کاربره/فروش ----------
SIGNUP_ENABLED=false
PLATFORM_ADMIN_EMAILS=admin@sina.local
SALES_BRAND=سینا OS

# ---------- اختیاری: ربات تلگرام خود سینا ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
