{
  "name": "Sina OS",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "postCreateCommand": "cd backend && pip install -r requirements.txt pytest pytest-asyncio httpx",
  "postStartCommand": "python sina.py run --no-browser --port 8765",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Sina OS console", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"] }
  }
}
